# Copy to .env and fill in real values. See BUILD_LOG.md for launch checklist.

# MongoDB connection string for lead capture (Prisma `Lead` model).
# Prisma's Mongo connector requires a replica set (even a single-node one locally).
# Managed hosts (Atlas, etc.) already run as a replica set — just use their connection string.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/freetools?retryWrites=true&w=majority"

# Required for the 12 AI-writer tools. Without it, those pages render with a disabled notice.
# ANTHROPIC_API_KEY=

# Optional: override the default AI model (claude-opus-4-8) for AI-writer tools.
# AI_MODEL=claude-opus-4-8

# EBOS module base URL that every tool's CTA links to (with UTM params appended).
# NEXT_PUBLIC_EBOS_URL=https://ebos.avexora.in
