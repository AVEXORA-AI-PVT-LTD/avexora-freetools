# Copy to .env and fill in real values. See BUILD_LOG.md for launch checklist.

# MongoDB connection string for lead capture (Prisma `Lead` model).
# Prisma's Mongo connector requires a replica set (even a single-node one locally).
# Managed hosts (Atlas, etc.) already run as a replica set — just use their connection string.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/freetools?retryWrites=true&w=majority"

# Required for the 12 AI-writer tools. Without it, those pages render with a disabled notice.
# ANTHROPIC_API_KEY=

# Optional: override the default AI model (claude-opus-4-8) for AI-writer tools.
# AI_MODEL=claude-opus-4-8

# EBOS module base URL that every tool's CTA links to (with UTM params appended).
# NEXT_PUBLIC_EBOS_URL=https://ebos.avexora.in


# ---------------------------------------------------------------------------
# Brand Studio (spec 22) — the paid tier at /studio.
# Everything below is optional: unset keys degrade the feature rather than
# breaking the build, so the whole product is demoable before any account
# exists.
# ---------------------------------------------------------------------------

# Session encryption for Auth.js. Required for sign-in to work at all.
# Generate with: npx auth secret
# AUTH_SECRET=

# Canonical app URL. Only needed in production behind a proxy.
# AUTH_URL=https://freetools.avexora.in

# Magic-link sign-in. Both are required together; without them the email form
# is hidden on the sign-in page.
# AUTH_RESEND_KEY=
# EMAIL_FROM="Avexora Brand Studio <studio@avexora.in>"

# Google OAuth. Both required together; without them the button is hidden.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional: override the model used for Studio brand curation and copy.
# Falls back to deterministic heuristics when ANTHROPIC_API_KEY is unset.
# STUDIO_AI_MODEL=claude-opus-5

# Razorpay subscriptions. Without RAZORPAY_KEY_ID the pricing page still
# renders and every plan limit is still enforced — only checkout returns 503.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# One Razorpay plan id per plan and billing cycle, created in the Razorpay
# dashboard. Kept in env so test and live accounts differ without a migration.
# RAZORPAY_PLAN_LAUNCH_MONTHLY=
# RAZORPAY_PLAN_LAUNCH_YEARLY=
# RAZORPAY_PLAN_GROWTH_MONTHLY=
# RAZORPAY_PLAN_GROWTH_YEARLY=
# RAZORPAY_PLAN_AGENCY_MONTHLY=
# RAZORPAY_PLAN_AGENCY_YEARLY=
