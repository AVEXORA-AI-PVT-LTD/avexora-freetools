generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Free-tools growth engine (spec 20) — unchanged.
// ---------------------------------------------------------------------------

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  event       String // email_gate | newsletter | cta_click
  email       String?
  name        String?
  toolSlug    String
  category    String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([toolSlug])
}

// ---------------------------------------------------------------------------
// Brand Studio (spec 22) — auth. Shapes are dictated by @auth/prisma-adapter.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  brands        Brand[]
  subscription  Subscription?
  usageCounters UsageCounter[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Brand Studio — brands, kits and generated assets.
// ---------------------------------------------------------------------------

/// A company's identity plus the statutory particulars the compliance engine
/// needs (spec 22 §4). `entityType` drives which rule set applies.
model Brand {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  name     String
  industry String

  // Statutory particulars — India. Optional at the model level because the
  // compliance engine, not the database, decides what is mandatory for a
  // given entity type.
  legalName         String?
  entityType        String // pvt-ltd | public-ltd | opc | llp | partnership | proprietorship
  cin               String?
  llpin             String?
  gstin             String?
  pan               String?
  registeredAddress String?
  city              String?
  state             String?
  pincode           String?
  phone             String?
  email             String?
  website           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kit       BrandKit?
  assets    Asset[]
  employees Employee[]

  @@index([userId])
}

/// The generated design system. `palette`, `typography` and `logoSpec` are
/// stored as JSON so the engine's token shapes can evolve without migrations.
model BrandKit {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  brandId    String @unique @db.ObjectId
  paletteId  String
  fontPairId String
  markStyle  String
  markSeed   Int
  logoLayout String @default("horizontal")
  tagline    String?
  tokens     Json
  version    Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

/// A generated artifact. `spec` holds the inputs needed to re-render it, not
/// the rendered bytes — output is always regenerated from the engine.
model Asset {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @db.ObjectId
  type    String // logo | letterhead | envelope | business-card | id-card | social-post | ad | email-signature
  variant String?
  spec    Json

  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, type])
}

/// Source data for batch ID-card generation (spec 21 §3, gap 3).
model Employee {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId     String  @db.ObjectId
  name        String
  designation String?
  empCode     String?
  department  String?
  bloodGroup  String?
  phone       String?
  email       String?
  photoUrl    String?
  validUntil  String?

  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Brand Studio — billing and metering.
// ---------------------------------------------------------------------------

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  plan   String @default("free") // free | launch | growth | agency
  status String @default("active") // active | halted | cancelled | pending
  cycle  String @default("monthly") // monthly | yearly

  razorpayCustomerId     String?
  razorpaySubscriptionId String? @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-plan quota metering. One row per user/period/metric; `period` is a
/// `YYYY-MM` string so a month's usage is a single upsert target.
model UsageCounter {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  period String // YYYY-MM
  metric String // exports | aiCurations
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, metric])
}
