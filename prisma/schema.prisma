generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Free-tools growth engine (spec 20) — unchanged.
// ---------------------------------------------------------------------------

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  event       String // email_gate | newsletter | cta_click
  email       String?
  name        String?
  toolSlug    String
  category    String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([toolSlug])
}

// ---------------------------------------------------------------------------
// Brand Studio (spec 22) — auth. Shapes are dictated by @auth/prisma-adapter.
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  role             String?   @default("user") // "user" | "admin" | "superadmin"
  isOnboarded      Boolean   @default(false)
  phone            String?
  companyName      String?
  jobRole          String?
  referralCodeUsed String?
  password         String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  recoveryCodes    String[]  @default([])
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime?
  
  status           String    @default("ACTIVE") // ACTIVE, DISABLED, BLOCKED
  customRoles      String[]  @default([])
  lastActiveAt     DateTime?
  disabledAt       DateTime?
  blockedAt        DateTime?
  deletedAt        DateTime?


  createdAt        DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  brands        Brand[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  usageCounters UsageCounter[]
  toolUsages    ToolUsage[]
  contentItems  ContentItem[]
  digitalCards  DigitalCard[]

  payments Payment[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  
  // Security Hardening Fields
  ip           String?
  userAgent    String?
  lastActive   DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  token      String   @unique
  expires    DateTime

  @@unique([email, token])
}


// ---------------------------------------------------------------------------
// Brand Studio — brands, kits and generated assets.
// ---------------------------------------------------------------------------

/// A company's identity plus the statutory particulars the compliance engine
/// needs (spec 22 §4). `entityType` drives which rule set applies.
model Brand {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  name     String
  industry String

  // Statutory particulars — India. Optional at the model level because the
  // compliance engine, not the database, decides what is mandatory for a
  // given entity type.
  legalName         String?
  entityType        String // pvt-ltd | public-ltd | opc | llp | partnership | proprietorship
  cin               String?
  llpin             String?
  gstin             String?
  pan               String?
  registeredAddress String?
  city              String?
  state             String?
  pincode           String?
  phone             String?
  email             String?
  website           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kit       BrandKit?
  assets    Asset[]
  employees Employee[]

  // Compound rather than [userId] alone: the dashboard and the brands API both
  // filter by user and sort by updatedAt desc, and a userId-only index leaves
  // the sort to be done in memory. The prefix still serves userId lookups.
  @@index([userId, updatedAt])
}

/// The generated design system. `palette`, `typography` and `logoSpec` are
/// stored as JSON so the engine's token shapes can evolve without migrations.
model BrandKit {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId    String  @unique @db.ObjectId
  paletteId  String
  fontPairId String
  markStyle  String
  markSeed   Int
  logoLayout String  @default("horizontal")
  tagline    String?
  tokens     Json
  version    Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

/// A generated artifact. `spec` holds the inputs needed to re-render it, not
/// the rendered bytes — output is always regenerated from the engine.
model Asset {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId String  @db.ObjectId
  type    String // logo | letterhead | envelope | business-card | id-card | social-post | ad | email-signature
  variant String?
  spec    Json

  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, type])
}

/// Source data for batch ID-card generation (spec 21 §3, gap 3).
model Employee {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId     String  @db.ObjectId
  name        String
  designation String?
  empCode     String?
  department  String?
  bloodGroup  String?
  phone       String?
  email       String?
  photoUrl    String?
  validUntil  String?

  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Every read of this collection is "one brand's roster, in joining order".
  @@index([brandId, createdAt])
}

// ---------------------------------------------------------------------------
// Brand Studio — magic-link rate limiting.
//
// Server-side, persistent rate-limit buckets for the magic-link sign-in. Keys
// are namespaced fixed windows (`key:<windowStartMs>`) so each window is its
// own document; the atomic upsert (create hits=1 / update increment) keeps the
// count correct under concurrent requests without a read-modify-write race.
// Unlike an in-memory Map, this is shared across serverless invocations and
// instances.
// ---------------------------------------------------------------------------

model MagicLinkRateLimit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  hits        Int      @default(1)
  windowStart DateTime

  updatedAt DateTime @updatedAt

  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// Brand Studio — billing and metering.
// ---------------------------------------------------------------------------

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  plan   String @default("free") // free | launch | growth | agency
  status String @default("active") // active | halted | cancelled | pending
  cycle  String @default("monthly") // monthly | yearly

  razorpayCustomerId     String?
  razorpaySubscriptionId String?   @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]
}

/// Per-plan quota metering. One row per user/period/metric; `period` is a
/// `YYYY-MM` string so a month's usage is a single upsert target.
model UsageCounter {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  period String // YYYY-MM
  metric String // exports | aiCurations
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, metric])
}

// ---------------------------------------------------------------------------
// Tool Usage Tracking (for Analytics and Admin Panel)
// ---------------------------------------------------------------------------

model ToolUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId // Optional, to allow anonymous usage
  toolSlug  String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolSlug, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Admin Panel Configurations
// ---------------------------------------------------------------------------

model CategoryConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String   @default("Unnamed Category")
  slug             String   @unique
  description      String?
  icon             String?
  image            String?
  parentId         String?  @db.ObjectId
  status           Boolean  @default(true)
  featured         Boolean  @default(false)
  displayOrder     Int      @default(0)
  seoMetadata      Json?
  
  createdBy        String?
  updatedBy        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent           CategoryConfig?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         CategoryConfig[] @relation("CategoryHierarchy")

  @@index([parentId])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
}
model ToolConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug         String   @unique
  categorySlug     String
  status           Boolean  @default(true)
  featured         Boolean  @default(false)
  pricing          String   @default("Free")
  priority         Int      @default(0)
  displayOrder     Int      @default(0)
  seoMetadata      Json?
  views            Int      @default(0)
  
  nameOverride     String?
  description      String?
  subCategory      String?
  tags             String[] @default([])
  icon             String?
  thumbnail        String?
  content          Json?
  runtimeConfig    Json?
  technicalConfig  Json?
  publishingConfig Json?
  homepageVisible  Boolean  @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedBy        String?
  currentVersion   String   @default("1.0.0")
}

model DynamicTool {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String   @unique
  type         String   // "calculator" | "generator" | "file-tool" | "ai-writer"
  icon         String?
  categorySlug String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CMS / Content Management
// ---------------------------------------------------------------------------

model ContentBlock {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  type        String   @default("TEXT")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hitCount    Int      @default(0)
  lastHitAt   DateTime?
}

// ---------------------------------------------------------------------------
// Navigation Management
// ---------------------------------------------------------------------------

model NavigationLink {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  label        String
  href         String
  location     String   // "HEADER" | "FOOTER"
  displayOrder Int      @default(0)
  status       Boolean  @default(true)
  type         String   @default("CUSTOM") // "INTERNAL" | "EXTERNAL" | "CUSTOM"
  openInNewTab Boolean  @default(false)
  
  nameOverride    String?
  description     String?
  subCategory     String?
  tags            String[] @default([])
  icon            String?
  thumbnail       String?
  content         Json?
  runtimeConfig   Json?
  technicalConfig Json?
  publishingConfig Json?
  homepageVisible Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit Logging (Admin Panel)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String?  @unique // e.g., "AUD-20260926-000124"
  actorId     String?  @db.ObjectId
  actorName   String?
  actorEmail  String?
  actorRole   String   @default("user")
  action      String   // Machine readable action name (e.g. "UPDATE_TOOL", "CREATE_ROLE")
  targetType  String   // Entity type (e.g. "Tool", "User", "Category", "Role")
  targetId    String?  // ID or slug of the affected resource
  targetName  String?  // Human readable title/name of the target resource
  status      String   @default("SUCCESS") // "SUCCESS" | "FAILED" | "DENIED"
  severity    String   @default("INFO") // "INFO" | "WARNING" | "CRITICAL"
  environment String   @default("production")
  ip          String?
  userAgent   String?
  requestId   String?
  metadata    Json?
  before      Json?
  after       Json?
  changes     Json?
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([status])
  @@index([requestId])
}

model ToolRevision {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug     String
  version      String
  changelog    String?
  snapshot     Json
  revisionType String   @default("Manual") // "Manual" | "Published" | "Restored" | "System"
  isPublished  Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([toolSlug, version(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model HomepageConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sectionKey  String   @unique
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  heading     String?
  description String?
  config      Json?
  
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hitCount    Int      @default(0)
  lastHitAt   DateTime?
}

enum ContentType {
  PAGE
  BLOG
  FAQ
  GUIDE
  DOCUMENTATION
  ABOUT
  CONTACT
  PRIVACY
  TERMS
  DISCLAIMER
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model ContentItem {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String        @unique
  contentType    ContentType
  content        String
  excerpt        String?
  featuredImage  String?
  status         ContentStatus @default(DRAFT)
  
  tags           String[]      @default([])
  category       String?
  
  seoTitle       String?
  metaDesc       String?
  ogTitle        String?
  ogDesc         String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean       @default(false)


  authorId       String        @db.ObjectId
  author         User          @relation(fields: [authorId], references: [id])
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  updatedBy      String?       @db.ObjectId
  
  version        Int           @default(1)
  views          Int           @default(0)
  
  featured       Boolean       @default(false)
  relatedTools   String[]      @default([])
  relatedPosts   String[]      @default([])

}

model ContentRevision {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  contentId      String      @db.ObjectId
  version        Int
  data           Json
  createdAt      DateTime    @default(now())
  createdBy      String      @db.ObjectId
}

model Redirect {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  source      String   @unique
  destination String
  statusCode  Int      @default(301)
  active      Boolean  @default(true)
  reason      String?
  createdBy   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hitCount    Int      @default(0)
  lastHitAt   DateTime?
}


model Plan {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique
  name             String
  description      String?
  tagline          String?
  
  monthlyPrice     Int      @default(0)
  yearlyPrice      Int      @default(0)
  currency         String   @default("INR")
  
  razorpayMonthlyId String?
  razorpayYearlyId  String?

  hasTrial         Boolean  @default(false)
  trialDays        Int      @default(0)

  limits           Json     @default("{}")
  capabilities     Json     @default("{}")
  
  watermark        Boolean  @default(false)
  highlights       String[] @default([])

  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  displayOrder     Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Payment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String   @db.ObjectId
  userId         String   @db.ObjectId
  amount         Int      
  currency       String   @default("INR")
  status         String   // "successful", "failed", "refunded", "partially_refunded"
  providerTxId   String?  // Razorpay Payment ID
  refundAmount   Int      @default(0) // Tracks refunded amount in paise
  taxAmount      Int      @default(0)
  paymentDate    DateTime @default(now())
  createdAt      DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A saved Digital Business Card, served publicly at /card/<slug>.
/// `data` holds the card's BusinessCardInput (validated on write) including
/// the photo and logo as small data URLs, so one read renders the whole page.
model DigitalCard {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  slug      String   @unique
  data      Json
  qrTarget  String   @default("contact") // contact | website | card
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model AdSlot {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  placement      String    // "header" | "homepage" | "tool_page" | "sidebar" | "footer"
  device         String    @default("all") // "all" | "desktop" | "mobile" | "tablet"
  adProvider     String    // "adsense" | "admanager" | "custom" | "internal"
  adReference    String?   // Ad unit ID / slot ID / promo asset ID
  customHtml     String?   // Sanitized custom markup for internal or custom ads
  destinationUrl String?   // For internal promo ads
  imageUrl       String?   // For internal promo image ads
  priority       Int       @default(1) // Priority order (1 = highest)
  active         Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  categorySlug   String?   // Target specific category (e.g., "business-legal")
  toolSlug       String?   // Target specific tool (e.g., "digital-business-card-generator")
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([placement, active, priority])
  @@index([device])
  @@index([startDate, endDate])
  @@index([categorySlug])
  @@index([toolSlug])
}

model MediaFolder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  parentId  String?  @db.ObjectId
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children MediaFolder[] @relation("FolderHierarchy")
  assets   MediaAsset[]

  @@index([parentId])
}

model MediaAsset {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  filename         String   // Display filename (e.g. "logo-2026.png")
  originalFilename String   // Original file name on upload
  storageKey       String   // Relative storage path or key (e.g. "uploads/2026/09/uuid.png")
  storageProvider  String   @default("local") // "local" | "s3" | "vercel-blob"
  storageUrl       String   // Full storage URL
  cdnUrl           String   // Public CDN / relative URL for web rendering
  mimeType         String   // e.g. "image/png"
  extension        String   // e.g. "png"
  size             Int      // File size in bytes
  width            Int?     // Image width in px if applicable
  height           Int?     // Image height in px if applicable
  altText          String?
  title            String?
  description      String?
  folderId         String?  @db.ObjectId
  tags             String[] @default([])
  assetType        String   @default("image") // "image" | "document" | "icon" | "thumbnail" | "brand"
  uploadedBy       String?  // Admin User ID or name
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@index([assetType])
  @@index([mimeType])
  @@index([createdAt])
}

model AiToolConfig {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug            String   @unique
  enabled             Boolean  @default(true)
  provider            String   @default("anthropic") // "anthropic" | "openai" | "gemini"
  model               String   @default("claude-opus-4-8")
  temperature         Float    @default(0.7)
  maxTokens           Int      @default(2048)
  inputLimitChars     Int      @default(5000)
  dailyLimitPerUser   Int      @default(50)
  monthlyLimitPerUser Int      @default(500)
  maintenanceMessage String?
  activePromptVersion Int      @default(1)
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AiPromptRevision {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug           String
  version            Int
  systemPrompt       String
  userPromptTemplate String
  variables          String[] @default([])
  status             String   @default("active") // "active" | "draft" | "archived"
  changeReason       String   @default("Initial release")
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([toolSlug, version])
  @@index([toolSlug, status])
}

model AiUsageLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug         String
  userId           String?  @db.ObjectId
  provider         String   @default("anthropic")
  model            String   @default("claude-opus-4-8")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0)
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([toolSlug, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model ContactSubmission {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  referenceId     String    @unique
  type            String    @default("Contact") // "Contact" | "Bug Report" | "Feature Request" | "Tool Feedback" | "Review"
  userId          String?   @db.ObjectId
  name            String
  email           String
  subject         String
  message         String
  toolSlug        String?
  priority        String    @default("Medium") // "Low" | "Medium" | "High" | "Urgent"
  status          String    @default("New") // "New" | "In Progress" | "Resolved" | "Closed" | "Spam"
  assignedAdminId String?   @db.ObjectId
  internalNotes   Json?
  attachments     String[]  @default([])
  browser         String?
  device          String?
  ipHash          String?
  userAgent       String?
  source          String?   @default("website")
  resolvedAt      DateTime?
  resolvedBy      String?   @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([type])
  @@index([priority])
  @@index([assignedAdminId])
  @@index([toolSlug])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model ErrorLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  errorId         String    @unique // e.g. "ERR-20260925-000124"
  fingerprint     String?   // e.g. "fp_ai_timeout_resume_writer" for deduplication
  occurrences     Int       @default(1)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  errorType       String    @default("Server Error") // "Tool Failure" | "API Failure" | "Server Error" | "404 Error" | "Upload Failure" | "AI Failure" | "Payment Failure" | "Authentication Failure" | "Database Failure" | "External Service Failure"
  toolSlug        String?
  userId          String?   @db.ObjectId
  errorCode       String?   // e.g. "AI_PROVIDER_TIMEOUT", "HTTP_404"
  message         String
  requestId       String?   // e.g. "req_8f92a71c"
  severity        String    @default("Medium") // "Low" | "Medium" | "High" | "Critical"
  status          String    @default("Open") // "Open" | "Investigating" | "Resolved" | "Ignored"
  environment     String    @default("Production") // "Development" | "Staging" | "Production"
  stackTrace      String?
  endpoint        String?
  method          String?
  metadata        Json?     // Sanitized params, headers, device info
  assignedAdminId String?   @db.ObjectId
  resolutionNote  String?
  resolvedAt      DateTime?
  resolvedBy      String?   @db.ObjectId
  internalNotes   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, severity, createdAt(sort: Desc)])
  @@index([errorType])
  @@index([toolSlug])
  @@index([userId])
  @@index([requestId])
  @@index([fingerprint])
  @@index([createdAt(sort: Desc)])
}

model Role {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String   @unique // e.g. "super_admin", "admin", "content_manager", "support", "finance", "seo_lead"
  description  String?
  permissions  String[] @default([]) // Array of permission keys e.g. ["tools.view", "content.create"]
  isSystemRole Boolean  @default(false)
  status       Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isSystemRole])
}

// ---------------------------------------------------------------------------
// Phase 26 — Admin Notifications & Webhooks
// ---------------------------------------------------------------------------

model Notification {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  type            String    // "NEW_USER" | "NEW_PAYMENT" | "FAILED_PAYMENT" | "TOOL_ERROR" | "SERVER_ERROR" | "NEW_FEEDBACK" | "NEW_CONTACT_REQUEST" | "SUBSCRIPTION_CANCELLED" | "BACKUP_FAILURE"
  title           String
  message         String
  severity        String    @default("INFO") // "INFO" | "SUCCESS" | "WARNING" | "ERROR" | "CRITICAL"
  status          String    @default("UNREAD") // "UNREAD" | "READ" | "ARCHIVED"
  recipientId     String?   @db.ObjectId // Specific target user ID or null for role-based broadcast
  eligibleRoles   String[]  @default([]) // Eligible role slugs or permissions
  targetType      String?   // "User", "Payment", "Tool", "Error", "Feedback", etc.
  targetId        String?
  targetName      String?
  actionUrl       String?   // Deep-link redirect URL
  groupKey        String?   // For deduplication & event aggregation
  occurrenceCount Int       @default(1)
  metadata        Json?
  readAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([recipientId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@index([targetId])
  @@index([groupKey])
}

model NotificationPreference {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  eventType        String   // e.g. "NEW_USER", "NEW_PAYMENT"
  dashboardEnabled Boolean  @default(true)
  emailEnabled     Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, eventType])
  @@index([userId])
}

model WebhookConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  url       String
  secret    String?
  events    String[] @default([])
  status    String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDeliveryLog[]

  @@index([status])
}

model WebhookDeliveryLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  webhookId    String   @db.ObjectId
  eventType    String
  payload      Json
  status       String   @default("PENDING") // "PENDING" | "SENT" | "FAILED" | "RETRYING"
  responseCode Int?
  errorMessage String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  webhook WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Phase 27 — Analytics Events
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType     String   // "pageview" | "tool_execution" | "tool_view" | "signup" | "subscription"
  userId        String?  @db.ObjectId
  sessionId     String?
  toolSlug      String?
  path          String?
  referrer      String?
  source        String?  @default("Direct") // utm_source or referrer
  medium        String?  // utm_medium
  campaign      String?  // utm_campaign
  country       String?  @default("India")
  device        String?  @default("desktop") // "desktop" | "mobile" | "tablet"
  browser       String?  @default("Chrome")
  os            String?  @default("macOS")
  success       Boolean  @default(true)
  executionTime Int?     // Duration in ms
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventType])
  @@index([toolSlug])
  @@index([userId])
  @@index([sessionId])
  @@index([source])
  @@index([country])
  @@index([device])
}

// ---------------------------------------------------------------------------
// Phase 28 — Reports & Export Management
// ---------------------------------------------------------------------------

model ReportJob {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  reportType       String    // "tool_usage" | "user_activity" | "revenue" | "subscription" | "website_traffic" | "seo" | "error" | "feedback"
  format           String    // "csv" | "xlsx" | "pdf"
  requestedBy      String    @db.ObjectId
  requestedByEmail String?
  status           String    @default("QUEUED") // "QUEUED" | "PROCESSING" | "COMPLETED" | "FAILED" | "CANCELLED" | "EXPIRED"
  filters          String?   // JSON serialized parameters
  dateFrom         DateTime?
  dateTo           DateTime?
  fileReference    String?   // Relative file path e.g. "storage/reports/rpt_12345.pdf"
  fileSize         Int?      // Size in bytes
  progress         Int       @default(0) // 0 to 100
  errorMessage     String?
  downloadCount    Int       @default(0)

  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime?

  @@index([requestedBy])
  @@index([status])
  @@index([reportType])
}

