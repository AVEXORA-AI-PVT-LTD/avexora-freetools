generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Free-tools growth engine (spec 20) — unchanged.
// ---------------------------------------------------------------------------

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  event       String // email_gate | newsletter | cta_click
  email       String?
  name        String?
  toolSlug    String
  category    String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([toolSlug])
}

// ---------------------------------------------------------------------------
// Brand Studio (spec 22) — auth. Shapes are dictated by @auth/prisma-adapter.
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  role             String?   @default("user") // "user" | "admin" | "superadmin"
  isOnboarded      Boolean   @default(false)
  phone            String?
  companyName      String?
  jobRole          String?
  referralCodeUsed String?
  password         String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  recoveryCodes    String[]  @default([])
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime?

  createdAt        DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  brands        Brand[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  usageCounters UsageCounter[]
  toolUsages    ToolUsage[]
  contentItems  ContentItem[]

}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  
  // Security Hardening Fields
  ip           String?
  userAgent    String?
  lastActive   DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  token      String   @unique
  expires    DateTime

  @@unique([email, token])
}


// ---------------------------------------------------------------------------
// Brand Studio — brands, kits and generated assets.
// ---------------------------------------------------------------------------

/// A company's identity plus the statutory particulars the compliance engine
/// needs (spec 22 §4). `entityType` drives which rule set applies.
model Brand {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  name     String
  industry String

  // Statutory particulars — India. Optional at the model level because the
  // compliance engine, not the database, decides what is mandatory for a
  // given entity type.
  legalName         String?
  entityType        String // pvt-ltd | public-ltd | opc | llp | partnership | proprietorship
  cin               String?
  llpin             String?
  gstin             String?
  pan               String?
  registeredAddress String?
  city              String?
  state             String?
  pincode           String?
  phone             String?
  email             String?
  website           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kit       BrandKit?
  assets    Asset[]
  employees Employee[]

  // Compound rather than [userId] alone: the dashboard and the brands API both
  // filter by user and sort by updatedAt desc, and a userId-only index leaves
  // the sort to be done in memory. The prefix still serves userId lookups.
  @@index([userId, updatedAt])
}

/// The generated design system. `palette`, `typography` and `logoSpec` are
/// stored as JSON so the engine's token shapes can evolve without migrations.
model BrandKit {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId    String  @unique @db.ObjectId
  paletteId  String
  fontPairId String
  markStyle  String
  markSeed   Int
  logoLayout String  @default("horizontal")
  tagline    String?
  tokens     Json
  version    Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

/// A generated artifact. `spec` holds the inputs needed to re-render it, not
/// the rendered bytes — output is always regenerated from the engine.
model Asset {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId String  @db.ObjectId
  type    String // logo | letterhead | envelope | business-card | id-card | social-post | ad | email-signature
  variant String?
  spec    Json

  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, type])
}

/// Source data for batch ID-card generation (spec 21 §3, gap 3).
model Employee {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId     String  @db.ObjectId
  name        String
  designation String?
  empCode     String?
  department  String?
  bloodGroup  String?
  phone       String?
  email       String?
  photoUrl    String?
  validUntil  String?

  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Every read of this collection is "one brand's roster, in joining order".
  @@index([brandId, createdAt])
}

// ---------------------------------------------------------------------------
// Brand Studio — magic-link rate limiting.
//
// Server-side, persistent rate-limit buckets for the magic-link sign-in. Keys
// are namespaced fixed windows (`key:<windowStartMs>`) so each window is its
// own document; the atomic upsert (create hits=1 / update increment) keeps the
// count correct under concurrent requests without a read-modify-write race.
// Unlike an in-memory Map, this is shared across serverless invocations and
// instances.
// ---------------------------------------------------------------------------

model MagicLinkRateLimit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  hits        Int      @default(1)
  windowStart DateTime

  updatedAt DateTime @updatedAt

  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// Brand Studio — billing and metering.
// ---------------------------------------------------------------------------

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  plan   String @default("free") // free | launch | growth | agency
  status String @default("active") // active | halted | cancelled | pending
  cycle  String @default("monthly") // monthly | yearly

  razorpayCustomerId     String?
  razorpaySubscriptionId String?   @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-plan quota metering. One row per user/period/metric; `period` is a
/// `YYYY-MM` string so a month's usage is a single upsert target.
model UsageCounter {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  period String // YYYY-MM
  metric String // exports | aiCurations
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, metric])
}

// ---------------------------------------------------------------------------
// Tool Usage Tracking (for Analytics and Admin Panel)
// ---------------------------------------------------------------------------

model ToolUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId // Optional, to allow anonymous usage
  toolSlug  String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolSlug, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Admin Panel Configurations
// ---------------------------------------------------------------------------

model CategoryConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String   @default("Unnamed Category")
  slug             String   @unique
  description      String?
  icon             String?
  image            String?
  parentId         String?  @db.ObjectId
  status           Boolean  @default(true)
  featured         Boolean  @default(false)
  displayOrder     Int      @default(0)
  seoMetadata      Json?
  
  createdBy        String?
  updatedBy        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent           CategoryConfig?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         CategoryConfig[] @relation("CategoryHierarchy")

  @@index([parentId])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
}
model ToolConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug         String   @unique
  categorySlug     String
  status           Boolean  @default(true)
  featured         Boolean  @default(false)
  pricing          String   @default("Free")
  priority         Int      @default(0)
  displayOrder     Int      @default(0)
  seoMetadata      Json?
  views            Int      @default(0)
  
  nameOverride     String?
  description      String?
  subCategory      String?
  tags             String[] @default([])
  icon             String?
  thumbnail        String?
  content          Json?
  runtimeConfig    Json?
  technicalConfig  Json?
  publishingConfig Json?
  homepageVisible  Boolean  @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedBy        String?
  currentVersion   String   @default("1.0.0")
}

model DynamicTool {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String   @unique
  type         String   // "calculator" | "generator" | "file-tool" | "ai-writer"
  icon         String?
  categorySlug String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CMS / Content Management
// ---------------------------------------------------------------------------

model ContentBlock {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  type        String   @default("TEXT")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Navigation Management
// ---------------------------------------------------------------------------

model NavigationLink {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  label        String
  href         String
  location     String   // "HEADER" | "FOOTER"
  displayOrder Int      @default(0)
  status       Boolean  @default(true)
  type         String   @default("CUSTOM") // "INTERNAL" | "EXTERNAL" | "CUSTOM"
  openInNewTab Boolean  @default(false)
  
  nameOverride    String?
  description     String?
  subCategory     String?
  tags            String[] @default([])
  icon            String?
  thumbnail       String?
  content         Json?
  runtimeConfig   Json?
  technicalConfig Json?
  publishingConfig Json?
  homepageVisible Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit Logging (Admin Panel)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String   @db.ObjectId
  actorRole  String
  action     String   // e.g., "TOOL_UPDATED", "CATEGORY_CREATED", "USER_BLOCKED"
  targetType String   // e.g., "TOOL", "CATEGORY", "USER", "SEO"
  targetId   String?  // ID or slug of the affected resource
  metadata   Json?    // Stores what changed, reason, etc.
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
}

model ToolRevision {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug     String
  version      String
  changelog    String?
  snapshot     Json
  revisionType String   @default("Manual") // "Manual" | "Published" | "Restored" | "System"
  isPublished  Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([toolSlug, version(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model HomepageConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sectionKey  String   @unique
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  heading     String?
  description String?
  config      Json?
  
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContentType {
  PAGE
  BLOG
  FAQ
  GUIDE
  DOCUMENTATION
  ABOUT
  CONTACT
  PRIVACY
  TERMS
  DISCLAIMER
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model ContentItem {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String        @unique
  contentType    ContentType
  content        String
  excerpt        String?
  featuredImage  String?
  status         ContentStatus @default(DRAFT)
  
  tags           String[]      @default([])
  category       String?
  
  seoTitle       String?
  metaDesc       String?
  ogTitle        String?
  ogDesc         String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean       @default(false)


  authorId       String        @db.ObjectId
  author         User          @relation(fields: [authorId], references: [id])
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  updatedBy      String?       @db.ObjectId
  
  version        Int           @default(1)
  views          Int           @default(0)
  
  featured       Boolean       @default(false)
  relatedTools   String[]      @default([])
  relatedPosts   String[]      @default([])

}

model ContentRevision {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  contentId      String      @db.ObjectId
  version        Int
  data           Json
  createdAt      DateTime    @default(now())
  createdBy      String      @db.ObjectId
}
